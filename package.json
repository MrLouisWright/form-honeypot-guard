{
  "name": "form-honeypot-guard",
  "version": "1.1.1",
  "description": "Block form spam bots without a captcha: honeypot + signed timing tokens + JS proof + optional Altcha-style proof-of-work + rate limiting. Webpack 5 and Vite plugins, a <2 kB client, Express/Fastify/Next/SvelteKit/Remix/Astro helpers, and a React wrapper. Zero runtime dependencies.",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.js",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./src/client.js",
      "require": "./dist/client.cjs"
    },
    "./runtime": "./src/runtime.js",
    "./runtime-pow": "./src/runtime-pow.js",
    "./webpack": {
      "types": "./src/webpack.d.ts",
      "require": "./src/webpack.cjs",
      "import": "./src/webpack.js"
    },
    "./vite": {
      "types": "./src/vite.d.ts",
      "import": "./src/vite.js"
    },
    "./check": {
      "types": "./dist/check.d.ts",
      "import": "./src/check.js",
      "require": "./dist/check.cjs"
    },
    "./adapters": {
      "types": "./dist/adapters.d.ts",
      "import": "./src/adapters.js",
      "require": "./dist/adapters.cjs"
    },
    "./pow": {
      "types": "./dist/pow.d.ts",
      "import": "./src/pow.js",
      "require": "./dist/pow.cjs"
    },
    "./sveltekit": {
      "types": "./dist/sveltekit.d.ts",
      "import": "./src/sveltekit.js",
      "require": "./dist/sveltekit.cjs"
    },
    "./remix": {
      "types": "./dist/remix.d.ts",
      "import": "./src/remix.js",
      "require": "./dist/remix.cjs"
    },
    "./astro": {
      "types": "./dist/astro.d.ts",
      "import": "./src/astro.js",
      "require": "./dist/astro.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./src/react.js",
      "require": "./dist/react.cjs"
    },
    "./package.json": "./package.json",
    "./config": {
      "types": "./src/config.d.ts"
    }
  },
  "bin": {
    "form-honeypot-guard": "bin/form-honeypot-guard.js"
  },
  "files": [
    "src",
    "dist",
    "bin",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/generate-types.mjs",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node --test test/*.test.js"
  },
  "peerDependencies": {
    "react": ">=17",
    "vite": ">=4",
    "webpack": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "webpack": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "express": "^4.22.3",
    "fastify": "^4.29.1",
    "html-webpack-plugin": "^5.6.8",
    "jsdom": "^24.1.3",
    "react": "^19.0.0",
    "typescript": "^5.8.2",
    "webpack": "^5.111.1"
  },
  "keywords": [
    "honeypot",
    "spam",
    "form",
    "anti-spam",
    "captcha",
    "captcha-alternative",
    "altcha",
    "proof-of-work",
    "bot",
    "bot-protection",
    "webpack",
    "webpack-plugin",
    "vite",
    "vite-plugin",
    "express",
    "fastify",
    "nextjs",
    "sveltekit",
    "remix",
    "astro",
    "react",
    "redis",
    "upstash",
    "cloudflare",
    "rate-limit",
    "hmac",
    "security"
  ],
  "author": "Louis Wright <hello@louiswright.co.uk> (https://github.com/MrLouisWright)",
  "license": "MIT",
  "funding": {
    "type": "stripe",
    "url": "https://donate.stripe.com/aFa00lek3cvX4Ds2Fk9EI0b"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrLouisWright/form-honeypot-guard.git"
  },
  "bugs": {
    "url": "https://github.com/MrLouisWright/form-honeypot-guard/issues"
  },
  "homepage": "https://mrlouiswright.github.io/form-honeypot-guard/"
}
